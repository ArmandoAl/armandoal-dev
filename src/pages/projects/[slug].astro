---
import ProjectScreen from '@features/projects/presentation/screens/ProjectScreen.astro';
import { getAllSlugs } from '@features/projects/data/repositories/project_repository';

export async function getStaticPaths() {
  return (await getAllSlugs('en')).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
---

<ProjectScreen lang="en" slug={slug!} />
