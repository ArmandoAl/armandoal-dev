---
import AppShell from '@app/shell/AppShell.astro';
import { CV_PATHS, ROUTE_NAMES } from '@app/router/route_names';
import { get as getProfile } from '@features/about/data/repositories/profile_repository';
import { getAll } from '@features/case_studies/data/repositories/case_study_repository';
import CaseStudyCard from '@features/case_studies/presentation/widgets/CaseStudyCard.astro';
import { getUiCopy, type Locale } from '@core/utils/i18n';
import NextSectionCard from '@core/widgets/NextSectionCard.astro';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const profile = await getProfile(lang);
if (!profile) throw new Error(`Missing profile for ${lang}`);
const studies = await getAll(lang);
const experienceCards = profile.data.experience.map((experience) => {
  const study = studies.find(({ data }) => data.translationKey === experience.caseStudy);
  if (!study) throw new Error(`Missing case study for experience: ${experience.caseStudy}/${lang}`);
  return { experience, study };
});
const ui = getUiCopy(lang);
const socialLinks = profile.data.links.filter(({ label }) => label === 'LinkedIn' || label === 'GitHub').map(({ url }) => url);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.data.name,
  jobTitle: profile.data.headline,
  knowsAbout: profile.data.skills,
  url: Astro.site ? new URL(ROUTE_NAMES[lang].home, Astro.site).href : ROUTE_NAMES[lang].home,
  sameAs: socialLinks,
  address: profile.data.address,
};
---

<AppShell title={`${profile.data.name} — ${profile.data.headline}`} description={profile.data.summary} {lang} activeRoute="home" {structuredData}>
  <header class="hero">
    <p class="md-label-large eyebrow">{profile.data.headline}</p>
    <span class="availability-badge md-label-large"><span class="availability-dot" aria-hidden="true"></span>{profile.data.availability} · {profile.data.timezone}</span>
    <h1 class="md-display-large">{profile.data.name}</h1>
    <div class="introduction">
      <p class="md-title-large summary">{profile.data.summary}</p>
      {profile.data.introduction.map((paragraph) => <p class="md-body-large">{paragraph}</p>)}
    </div>
    <div class="hero-actions">
      <a class="hero-cta hero-cta--primary md-state-layer" href="#experience">{ui.sections.experience}</a>
      <a class="hero-cta hero-cta--secondary md-state-layer" href={ROUTE_NAMES[lang].contact}>{ui.actions.contact}</a>
    </div>
    <div class="cv-actions">
      <a href={CV_PATHS[lang]} download class="md-label-large">{ui.actions.downloadCv}</a>
      <span class="md-body-medium">{profile.data.languages.join(' · ')}</span>
    </div>
  </header>

  <section id="experience" class="section featured-work" aria-labelledby="experience-title">
    <h2 id="experience-title" class="md-headline-large">{ui.sections.experience}</h2>
    <div class="case-grid">
      {experienceCards.map(({ study, experience }) => <CaseStudyCard {study} {experience} {lang} />)}
    </div>
  </section>

  <section class="section education" aria-labelledby="education-title">
    <h2 id="education-title" class="md-headline-large">{lang === 'es' ? 'Educación y reconocimientos' : 'Education & achievements'}</h2>
    <div class="education-list">
      {profile.data.education.map((item) => (
        <article class="education-item">
          <div class="education-item__header">
            <div>
              <h3 class="md-title-large">{item.title}</h3>
              <p class="md-body-large institution">{item.institution}{item.period && ` (${item.period})`}</p>
            </div>
            {item.url && <a class="publication-link md-label-large md-state-layer" href={item.url}>{lang === 'es' ? 'Leer artículo' : 'Read article'} <span aria-hidden="true">↗</span></a>}
          </div>
          {item.description && <p class="md-body-large publication-description">{item.description}</p>}
          {item.achievements.length > 0 && <ul class="awards">
            {item.achievements.map((award) => <li><h4 class="md-title-medium">{award.title}</h4><p class="md-body-medium">{award.description}</p></li>)}
          </ul>}
        </article>
      ))}
    </div>
    <div class="certifications">
      <h3 class="md-title-medium">{ui.sections.certifications}</h3>
      <ul>{profile.data.certifications.map((item) => <li class="md-body-medium">{item}</li>)}</ul>
    </div>
  </section>

  <section class="section expertise" aria-labelledby="expertise-title">
    <h2 id="expertise-title" class="md-headline-large">{lang === 'es' ? 'Áreas de especialidad' : 'Core expertise'}</h2>
    <ul>{profile.data.skills.map((item) => <li class="md-title-medium">{item}</li>)}</ul>
  </section>

  <section class="contact-row" aria-labelledby="contact-title">
    <h2 id="contact-title" class="md-headline-large">{ui.sections.contact}</h2>
    <div>
      {profile.data.links.map((link) => (
        <a class="md-label-large md-state-layer" href={link.url} download={link.label === 'CV' ? '' : undefined}>{link.label}</a>
      ))}
    </div>
  </section>
  <NextSectionCard href={ROUTE_NAMES[lang].projects} label={ui.nextSection.label} title={ui.nav.projects} description={ui.nextSection.projects} />
</AppShell>

<style>
  .hero { isolation: isolate; max-width: 820px; padding-block: 40px 32px; position: relative; }
  .hero::before {
    background:
      radial-gradient(circle closest-side at 24% 30%, color-mix(in srgb, var(--md-primary) 16%, transparent), transparent),
      radial-gradient(circle closest-side at 82% 75%, color-mix(in srgb, var(--md-tertiary) 10%, transparent), transparent);
    content: '';
    inset: -64px 0;
    pointer-events: none;
    position: absolute;
    z-index: -1;
  }
  .eyebrow { color: var(--md-primary); margin-bottom: 16px; text-transform: uppercase; }
  .availability-badge { align-items: center; background: var(--md-surface-container); border: 1px solid var(--md-outline-variant); border-radius: 999px; color: var(--md-on-surface); display: inline-flex; gap: 10px; margin-bottom: 20px; padding: 8px 16px 8px 12px; }
  .availability-dot { background: var(--md-primary); border-radius: 50%; box-shadow: 0 0 0 4px color-mix(in srgb, var(--md-primary) 22%, transparent); flex: none; height: 8px; width: 8px; }
  h1 { font-weight: 800; letter-spacing: -0.02em; }
  .summary { color: var(--md-on-surface-variant); font-size: 16px; letter-spacing: 0; line-height: 1.5; margin: 0 0 16px; max-width: 68ch; }
  .introduction { color: var(--md-on-surface-variant); margin-block: 24px 32px; max-width: 72ch; }
  .introduction p + p { line-height: 1.7; margin-top: 16px; }
  .cv-actions { align-items: center; color: var(--md-on-surface-variant); display: flex; flex-wrap: wrap; gap: 16px; margin-top: 24px; }
  .cv-actions a { color: var(--md-primary); padding-block: 12px; text-underline-offset: 4px; }
  #experience { scroll-margin-top: 100px; }
  .education { background: var(--md-surface-container-low); border: 1px solid var(--md-outline-variant); border-radius: 28px; padding: 32px; }
  .certifications { border-top: 1px solid var(--md-outline-variant); margin-top: 32px; padding-top: 24px; }
  .certifications ul { color: var(--md-on-surface-variant); display: flex; flex-wrap: wrap; gap: 12px 32px; padding-left: 20px; }
  .education-list { display: grid; gap: 32px; }
  .education-item { padding-left: 24px; position: relative; }
  .education-item__header { align-items: center; display: flex; flex-wrap: wrap; gap: 16px 24px; justify-content: space-between; }
  .education-item__header > div { flex: 1 1 280px; min-width: 0; }
  .publication-link { align-items: center; background: var(--md-primary-container); border-radius: 999px; color: var(--md-on-primary-container); display: inline-flex; flex: none; gap: 12px; min-height: 48px; padding: 12px 20px; text-decoration: none; }
  .publication-link:focus-visible { outline: 3px solid var(--md-primary); outline-offset: 4px; }
  .publication-description { color: var(--md-on-surface-variant); line-height: 1.7; margin-top: 16px; max-width: 78ch; }
  .education-item::before { background: var(--md-primary); border-radius: 50%; content: ''; height: 8px; left: 0; position: absolute; top: 12px; width: 8px; }
  .institution { color: var(--md-on-surface-variant); margin-top: 8px; }
  .awards { display: grid; gap: 12px; list-style: none; margin: 20px 0 0; padding: 0; }
  .awards li { background: var(--md-surface); border: 1px solid color-mix(in srgb, var(--md-primary) 28%, transparent); border-radius: 12px; padding: 18px 20px; }
  .awards li:nth-child(2) { border-color: color-mix(in srgb, var(--md-tertiary) 32%, transparent); }
  .awards p { color: var(--md-on-surface-variant); margin-top: 6px; }
  .expertise ul { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); list-style: none; margin: 0; padding: 0; }
  .expertise li { background: var(--md-surface-container-low); border: 1px solid var(--md-outline-variant); border-radius: 16px; padding: 24px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-cta { border-radius: 999px; font: 700 15px/1 var(--md-font-family); padding: 16px 24px; text-decoration: none; }
  .hero-cta--primary { background: var(--md-primary); color: var(--md-on-primary); }
  .hero-cta--secondary { border: 1px solid var(--md-outline); color: var(--md-on-surface); }
  .section { padding-block: 64px; }
  .section > h2, .contact-row > h2 { margin-bottom: 24px; }
  .section > h2::before, .contact-row > h2::before { background: var(--md-primary); border-radius: 3px; content: ''; display: block; height: 3px; margin-bottom: 12px; width: 40px; }
  .featured-work { padding-block: 48px 72px; }
  .case-grid { align-items: stretch; display: grid; gap: 20px; }
  @media (min-width: 1000px) { .case-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .contact-row { align-items: center; background: linear-gradient(120deg, var(--md-surface-container), var(--md-surface-container-high)); border: 1px solid var(--md-outline-variant); border-radius: 28px; display: flex; flex-wrap: wrap; gap: 24px; justify-content: space-between; margin-block: 72px 24px; padding: 40px 48px; }
  .contact-row > h2 { margin-bottom: 0; }
  .contact-row div { display: flex; flex-wrap: wrap; gap: 12px; }
  .contact-row a { border: 1px solid var(--md-outline); border-radius: 999px; color: var(--md-primary); padding: 10px 18px; text-decoration: none; }

  @media (max-width: 599px) {
    .hero { padding-block: 32px 56px; }
    h1 { font-size: 45px; line-height: 52px; }
    .hero-actions { flex-direction: column; }
    .hero-cta { text-align: center; }
    .contact-row { padding: 32px 24px; }
  }

  @media (min-width: 840px) {
    h1 { font-size: clamp(57px, 4vw + 1rem, 80px); line-height: 0.98; }
  }
</style>
