---
import AppShell from '@app/shell/AppShell.astro';
import { ROUTE_NAMES } from '@app/router/route_names';
import { get as getProfile } from '@features/about/data/repositories/profile_repository';
import { getFeatured } from '@features/case_studies/data/repositories/case_study_repository';
import CaseStudyCard from '@features/case_studies/presentation/widgets/CaseStudyCard.astro';
import { getUiCopy, type Locale } from '@core/utils/i18n';
import NextSectionCard from '@core/widgets/NextSectionCard.astro';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const profile = await getProfile(lang);
if (!profile) throw new Error(`Missing profile for ${lang}`);
const featured = await getFeatured(lang);
const ui = getUiCopy(lang);
const socialLinks = profile.data.links.filter(({ label }) => label === 'LinkedIn' || label === 'GitHub').map(({ url }) => url);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.data.name,
  jobTitle: profile.data.headline,
  knowsAbout: profile.data.skills.flatMap(({ items }) => items),
  url: Astro.site ? new URL(ROUTE_NAMES[lang].home, Astro.site).href : ROUTE_NAMES[lang].home,
  sameAs: socialLinks,
  address: profile.data.address,
};
---

<AppShell title={`${profile.data.name} — ${profile.data.headline}`} description={profile.data.summary} {lang} activeRoute="home" {structuredData}>
  <header class="hero md-enter md-enter-1">
    <p class="md-label-large eyebrow">{profile.data.headline}</p>
    <span class="availability-badge md-label-large"><span class="availability-dot" aria-hidden="true"></span>{profile.data.availability} · {profile.data.timezone}</span>
    <h1 class="md-display-large">{profile.data.name}</h1>
    <p class="md-title-large summary">{profile.data.summary}</p>
    <div class="hero-actions">
      <a class="hero-cta hero-cta--primary md-state-layer" href={ROUTE_NAMES[lang].work}>{ui.actions.viewWork}</a>
      <a class="hero-cta hero-cta--secondary md-state-layer" href={ROUTE_NAMES[lang].contact}>{ui.actions.contact}</a>
    </div>
  </header>

  <section class="section featured-work md-enter md-enter-2" aria-labelledby="featured-title">
    <h2 id="featured-title" class="md-headline-large">{ui.sections.featuredWork}</h2>
    <div class="case-grid">
      {featured.map((study) => <CaseStudyCard {study} {lang} />)}
    </div>
  </section>

  <section class="contact-row md-enter md-enter-3" aria-labelledby="contact-title">
    <h2 id="contact-title" class="md-headline-large">{ui.sections.contact}</h2>
    <div>
      {profile.data.links.map((link) => (
        <a class="md-label-large md-state-layer" href={link.url} download={link.label === 'CV' ? '' : undefined}>{link.label}</a>
      ))}
    </div>
  </section>
  <NextSectionCard href={ROUTE_NAMES[lang].work} label={ui.nextSection.label} title={ui.nav.work} description={ui.nextSection.work} />
</AppShell>

<style>
  .hero { isolation: isolate; max-width: 820px; padding-block: 40px 72px; position: relative; }
  .hero::before {
    background:
      radial-gradient(circle closest-side at 24% 30%, color-mix(in srgb, var(--md-primary) 16%, transparent), transparent),
      radial-gradient(circle closest-side at 82% 75%, color-mix(in srgb, var(--md-tertiary) 10%, transparent), transparent);
    content: '';
    inset: -64px 0;
    pointer-events: none;
    position: absolute;
    z-index: -1;
  }
  .eyebrow { color: var(--md-primary); margin-bottom: 16px; text-transform: uppercase; }
  .availability-badge { align-items: center; background: var(--md-surface-container); border: 1px solid var(--md-outline-variant); border-radius: 999px; color: var(--md-on-surface); display: inline-flex; gap: 10px; margin-bottom: 20px; padding: 8px 16px 8px 12px; }
  .availability-dot { background: var(--md-primary); border-radius: 50%; box-shadow: 0 0 0 4px color-mix(in srgb, var(--md-primary) 22%, transparent); flex: none; height: 8px; width: 8px; }
  h1 { font-weight: 800; letter-spacing: -0.02em; }
  .summary { color: var(--md-on-surface-variant); margin: 24px 0 32px; max-width: 68ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-cta { border-radius: 999px; font: 700 15px/1 var(--md-font-family); padding: 16px 24px; text-decoration: none; }
  .hero-cta--primary { background: var(--md-primary); color: var(--md-on-primary); }
  .hero-cta--secondary { border: 1px solid var(--md-outline); color: var(--md-on-surface); }
  .section { padding-block: 64px; }
  .section > h2, .contact-row > h2 { margin-bottom: 24px; }
  .section > h2::before, .contact-row > h2::before { background: var(--md-primary); border-radius: 3px; content: ''; display: block; height: 3px; margin-bottom: 12px; width: 40px; }
  .featured-work { padding-block: 48px 72px; }
  .case-grid { display: grid; gap: 24px; }
  .contact-row { align-items: center; background: linear-gradient(120deg, var(--md-surface-container), var(--md-surface-container-high)); border: 1px solid var(--md-outline-variant); border-radius: 28px; display: flex; flex-wrap: wrap; gap: 24px; justify-content: space-between; margin-block: 72px 24px; padding: 40px 48px; }
  .contact-row > h2 { margin-bottom: 0; }
  .contact-row div { display: flex; flex-wrap: wrap; gap: 12px; }
  .contact-row a { border: 1px solid var(--md-outline); border-radius: 999px; color: var(--md-primary); padding: 10px 18px; text-decoration: none; }

  @media (max-width: 599px) {
    .hero { padding-block: 32px 56px; }
    h1 { font-size: 45px; line-height: 52px; }
    .hero-actions { flex-direction: column; }
    .hero-cta { text-align: center; }
    .contact-row { padding: 32px 24px; }
  }

  @media (min-width: 840px) {
    h1 { font-size: clamp(57px, 4vw + 1rem, 80px); line-height: 0.98; }
  }
</style>
