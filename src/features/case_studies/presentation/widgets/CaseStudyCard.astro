---
import type { CollectionEntry } from 'astro:content';
import { ROUTE_NAMES } from '@app/router/route_names';
import AppIcon from '@core/widgets/AppIcon.astro';
import { caseMetaName } from '@core/utils/view_transition';
import type { Locale } from '@core/utils/i18n';
import { caseAccentStyle } from '@core/theme/case_accents';

interface Props {
  study: CollectionEntry<'caseStudies'>;
  experience: CollectionEntry<'profile'>['data']['experience'][number];
  lang: Locale;
}

const { study, experience, lang } = Astro.props;
const { data } = study;
---

<article class="case-card md-elevation-1" style={caseAccentStyle(data.order)}>
  <header>
    <p class="client md-title-medium">{experience.company}</p>
    <h3 class="md-headline-medium">{experience.role}</h3>
    <p class="meta md-label-large" style={`view-transition-name: ${caseMetaName(data.slug)};`}>{experience.period} · {experience.mode}</p>
  </header>
  <ul class="achievements">{experience.bullets.map((bullet) => <li class="md-body-large">{bullet}</li>)}</ul>
  <a class="case-card__cta md-state-layer" href={ROUTE_NAMES[lang].workDetail(data.slug)}>
    {lang === 'es' ? 'Ver proyecto' : 'View project'}<AppIcon name="arrow-right" size={20} state="active" />
  </a>
</article>

<style>
  .case-card { background: var(--md-surface-container-low); border: 1px solid var(--md-outline-variant); border-left: 4px solid var(--case-accent); border-radius: 28px; display: flex; flex-direction: column; gap: 20px; min-width: 0; padding: 28px; }
  .client { color: var(--case-accent); margin: 0 0 10px; }
  h3 { font-weight: 700; letter-spacing: -0.025em; }
  .meta { color: var(--md-on-surface-variant); line-height: 1.6; margin: 10px 0 0; }
  .achievements { color: var(--md-on-surface-variant); display: grid; gap: 10px; margin: 0; padding-left: 20px; }
  .achievements li { line-height: 1.6; padding-left: 2px; }
  .achievements li::marker { color: var(--case-accent); }
  .case-card__cta { --app-icon-active-color: currentColor; align-items: center; background: var(--case-accent-container); border-radius: 999px; color: var(--case-on-accent-container); display: flex; font: 700 14px/20px var(--md-font-family); gap: 16px; justify-content: space-between; margin-top: auto; min-height: 48px; padding: 12px 20px; text-decoration: none; }
  a:focus-visible { outline: 3px solid var(--case-accent); outline-offset: 4px; }
  @media (max-width: 599px) { .case-card { padding: 24px; } }
</style>
