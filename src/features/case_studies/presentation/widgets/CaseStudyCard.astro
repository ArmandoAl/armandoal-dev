---
import type { CollectionEntry } from 'astro:content';
import { ROUTE_NAMES } from '@app/router/route_names';
import Ripple from '@core/widgets/Ripple.astro';
import AppIcon from '@core/widgets/AppIcon.astro';
import { caseMetaName, caseTitleName } from '@core/utils/view_transition';
import type { Locale } from '@core/utils/i18n';
import { caseAccentStyle } from '@core/theme/case_accents';
import { Image } from 'astro:assets';

interface Props {
  study: CollectionEntry<'caseStudies'>;
  lang: Locale;
}

const { study, lang } = Astro.props;
const { data } = study;
const thumbnail = data.gallery?.[0];
const visibleStack = data.stack.slice(0, 4);
const remainingStack = data.stack.length - visibleStack.length;
---

<Ripple style="border-radius: 30px; display: block; width: 100%; --md-ripple-color: var(--md-on-surface);">
  <a class:list={['case-card', 'md-elevation-2', 'md-state-layer', { 'case-card--with-thumbnail': thumbnail }]} href={ROUTE_NAMES[lang].workDetail(data.slug)} style={caseAccentStyle(data.order)}>
    {thumbnail && (
      <div class:list={['case-card__thumbnail', `case-card__thumbnail--${thumbnail.kind}`]}>
        <Image src={thumbnail.src} alt={thumbnail.alt} width={480} height={thumbnail.kind === 'mobile' ? 1040 : 360} widths={[320, 480]} sizes="(max-width: 599px) 100vw, 40vw" format="webp" loading="lazy" decoding="async" />
      </div>
    )}
    <div class="case-card__body">
      <div class="case-card__meta md-label-large" style={`view-transition-name: ${caseMetaName(data.slug)};`}>
        <span class="client md-title-medium">{data.client}</span>
        <span>{data.role}</span>
        <span>{data.period}</span>
      </div>
      <h3 class="md-headline-large" style={`view-transition-name: ${caseTitleName(data.slug)};`}>{data.title}</h3>
      <p class="md-body-large">{data.summary}</p>
      <ul aria-label="Stack">
        {visibleStack.map((item) => <li class="md-label-medium">{item}</li>)}
        {remainingStack > 0 && <li class="md-label-medium">+{remainingStack}</li>}
      </ul>
      <span class="case-card__cta">{lang === 'es' ? 'Ver proyecto' : 'View project'}<AppIcon name="arrow-right" size={24} state="active" /></span>
    </div>
  </a>
</Ripple>

<style>
  .case-card { background: var(--md-surface-container-low); border: 1px solid var(--md-outline-variant); border-left: 4px solid var(--case-accent); border-radius: 30px; color: var(--md-on-surface); display: grid; gap: 28px; min-height: 300px; min-width: 0; overflow: hidden; padding: 28px; text-decoration: none; transition: border-color 240ms var(--md-easing-standard), background-color 240ms var(--md-easing-standard), transform 360ms var(--md-easing-emphasized-decelerate), box-shadow 360ms var(--md-easing-emphasized-decelerate); }
  .case-card__body { align-content: start; display: grid; gap: 16px; min-width: 0; }
  .case-card__thumbnail { aspect-ratio: 16 / 10; background: var(--md-surface-container-high); border-radius: 22px; min-height: 0; min-width: 0; overflow: hidden; }
  .case-card__thumbnail img { display: block; height: 100%; min-width: 0; object-fit: cover; width: 100%; transition: transform 700ms var(--md-easing-emphasized-decelerate); }
  .case-card__thumbnail--mobile img { object-fit: contain; padding: clamp(12px, 3vw, 32px); }
  .case-card__meta { align-items: center; color: var(--md-on-surface-variant); display: flex; flex-wrap: wrap; font-size: 16px; font-weight: 400; gap: 8px 20px; letter-spacing: 0; }
  .client { color: var(--case-accent); font-size: 16px; font-weight: 400; }
  h3 { color: var(--md-on-surface); font-size: clamp(24px, 2.2vw, 34px); font-weight: 700; letter-spacing: -0.035em; line-height: 1.12; overflow-wrap: anywhere; }
  p { color: var(--md-on-surface-variant); display: -webkit-box; letter-spacing: 0; line-height: 1.65; margin: 0; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 4; }
  ul { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; }
  li { background: var(--case-accent-container); border-radius: 999px; color: var(--case-on-accent-container); font-size: 16px; font-weight: 400; letter-spacing: 0; padding: 5px 10px; white-space: nowrap; }
  .case-card__cta { --app-icon-active-color: currentColor; align-items: center; background: var(--case-accent-container); border-radius: 999px; color: var(--case-on-accent-container); display: flex; font-size: 16px; font-weight: 700; gap: 16px; justify-content: space-between; margin-top: 8px; min-height: 56px; padding: 0 22px; transition: gap 240ms var(--md-easing-emphasized-decelerate), filter 240ms ease; }
  .case-card:focus-visible { outline: 3px solid var(--md-primary); outline-offset: 5px; }

  @media (min-width: 760px) {
    .case-card--with-thumbnail { align-items: stretch; gap: clamp(28px, 4vw, 64px); grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr); min-height: 440px; padding: clamp(32px, 5vw, 72px); }
    .case-card--with-thumbnail .case-card__thumbnail { aspect-ratio: 1.38; grid-column: 2; grid-row: 1; height: 100%; max-height: 560px; min-height: 320px; width: 100%; }
    .case-card--with-thumbnail .case-card__body { align-self: center; gap: 20px; grid-column: 1; grid-row: 1; }
  }

  @media (max-width: 759px) {
    .case-card { gap: 24px; grid-template-columns: minmax(0, 1fr); padding: 24px; }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .case-card:hover { border-color: var(--case-accent); box-shadow: 0 28px 72px -38px color-mix(in srgb, var(--case-accent) 55%, transparent); transform: translateY(-5px); }
    .case-card:hover .case-card__thumbnail img { transform: scale(1.035); }
    .case-card:hover .case-card__cta { filter: brightness(1.08); gap: 24px; }
  }
</style>
